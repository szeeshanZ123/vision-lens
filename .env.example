# ==============================================================================
# Vision Lens - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your credentials:
# cp .env.example .env

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Multimodal Model Selection (gemini-2.5-flash recommended for lowest latency)
# Supported options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Local Server Host & Port configuration
HOST=0.0.0.0
PORT=8000

